{
  "id": "webfill",
  "name": "Web fill",
  "description": "Cited specs, prices and materials.",
  "mark": "WEB",
  "tint": "#f3f4f6",
  "ink": "#3a4350",
  "runner": "llm",
  "runs_on": "Muse Spark search",
  "inputs": {
    "kinds": [
      "image",
      "note",
      "link"
    ]
  },
  "params": {
    "type": "object",
    "properties": {}
  },
  "outputs": [
    "attributes"
  ],
  "requires": [
