{
  "id": "video",
  "name": "Video",
  "description": "Short clips from an image and a direction.",
  "mark": "VID",
  "tint": "#f6e6d6",
  "ink": "#9a5410",
  "runner": "model",
  "runs_on": "fal · Kling",
  "inputs": {
    "kinds": [
      "image"
    ],
    "min": 1,
    "max": 1
  },
  "params": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "standard",
          "pro"
        ],
        "default": "standard",
        "x-widget": "segmented"
      },
      "duration": {
        "type": "integer",
        "enum": [
          5,
          10
        ],
        "default": 5
      },
      "prompt": {
        "type": "string",
        "x-widget": "prompt",
        "x-describe": true
      },
      "start": {
        "type": "string",
        "x-widget": "frame",
        "x-swap-with": "end"
      },
      "end": {
        "type": "string",
        "x-widget": "frame",
        "x-swap-with": "start"
      }
    }
  },
  "outputs": [
    "video"
  ],
  "requires": [
    "FAL_KEY"
  ],
  "model": "video.generate",
  "secondary": "Track with SAM"
}
