{
  "id": "cleanup",
  "name": "Clean-up",
  "description": "Cuts the object out of each picture and drops the background, on transparent or white.",
  "mark": "CLN",
  "tint": "#f3f4f6",
  "ink": "#3a4350",
  "runner": "python",
  "runs_on": "SAM 3.1",
  "inputs": {
    "kinds": [
      "image"
    ],
    "min": 1,
    "max": 4
  },
  "params": {
    "type": "object",
    "properties": {
      "background": {
        "type": "string",
        "enum": [
          "transparent",
          "white"
        ],
        "default": "transparent"
      }
    }
  },
  "outputs": [
    "images"
  ],
  "requires": [],
  "entry": "main.py",
  "needs": [
    "object_mask"
  ]
}
