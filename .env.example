# Live Meta models by default. For offline work (no key) force mocks:
#   REASONING_PROVIDER=mock SEGMENTATION_PROVIDER=mock EMBEDDER=mock
# Without MODEL_API_KEY the app still starts; model actions fail with PROVIDER_MISCONFIGURED.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# REASONING_PROVIDER=mock
MUSE_SPARK_MODEL=muse-spark-1.3
# SEGMENTATION_PROVIDER=mock
# EMBEDDER=mock
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open
PEXELS_API_KEY=
PEXELS_ENABLED=0
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# free, instant: https://api.data.gov/signup (live search skips the Smithsonian without it)
SMITHSONIAN_API_KEY=
# free, instant: https://pro.europeana.eu/page/get-api (live search skips Europeana without it)
EUROPEANA_API_KEY=
CONTACT_EMAIL=
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2
DATABASE_URL=sqlite:///./data/dle.sqlite
DATA_DIR=./data
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MAX_VIDEO_SECONDS=90
LINK_FETCH_TIMEOUT_S=5
SHAPE_KIND_ENABLED=0
# Live licensed-source search inside Vary (docs/live-search.md)
LIVE_SEARCH=1
LIVE_SOURCES=commons,openverse,met,aic,smithsonian,europeana,cleveland
LIVE_MAX_CANDIDATES=40
LIVE_TIMEOUT_S=20
LIVE_PER_SOURCE_LIMIT=15
LIVE_QUERY_COUNT=4
LIVE_SOURCE_COOLDOWN_S=900
EXTENSION_ORIGIN=
PUBLIC_APP_URL=http://localhost:5173
